# Copy to .env and fill in. Never commit the real .env — it holds live
# broker credentials once populated.

# --- Market data / broker provider ---
# "mock" (default): simulated feed, no credentials needed, safe for dev.
# "kite": live Zerodha Kite Connect — everything below becomes required.
MARKET_DATA_PROVIDER=mock

# --- Kite Connect (only needed when MARKET_DATA_PROVIDER=kite) ---
# From your app in https://developers.kite.trade/apps
KITE_API_KEY=
# KITE_API_SECRET is only needed by scripts/kite_login.py (the daily login
# exchange), never by the running server — do not set it here in an
# environment the server process reads from.

# KITE_ACCESS_TOKEN expires daily (~6 AM IST). Run scripts/kite_login.py
# each trading morning to refresh it; that script writes it here for you.
KITE_ACCESS_TOKEN=
